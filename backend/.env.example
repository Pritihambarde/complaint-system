# Copy values into your terminal environment (or set them before running uvicorn)
# DATABASE_URL: leave unset to use the built-in SQLite file (backend/complaints.db, zero setup).
# To use MySQL instead (e.g. via XAMPP), create an empty database first, then set:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/complaints_db
# MONGO_URL: the audit log (admin dashboard's "audit log" table) is stored in MongoDB.
# Default assumes MongoDB running locally with no auth. Install MongoDB Community Server
# (or use Docker: docker run -d -p 27017:27017 mongo) and it works with no other setup.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=complaints_system
COLLEGE_DOMAIN=mgmcen.ac.in
SECRET_KEY=change-this-to-a-long-random-string
SLA_SCALE=1            # 1 = real SLA (24h/48h/5d/7d). Use 0.0005 for a live escalation demo
ESCALATION_INTERVAL=60 # seconds between automatic SLA checks (0 = disabled)
DEBUG_OTP=1            # 1 = show reset OTP in API response (demo only). Set 0 in production
# EMAIL ALERTS: fill SMTP_HOST/USER/PASS to really send mail (otherwise mails are only printed in the server console).
# Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_USER=<mailbox>, SMTP_PASS=<16-char App Password>
# Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=            # "From" address of the alert mails (defaults to SMTP_USER)
APP_URL=http://127.0.0.1:8000   # link placed inside alert mails (use your real site address)
DEBUG_ERRORS=1          # set 0 in production
